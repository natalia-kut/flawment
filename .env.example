# Local development only. Bootstrap copies this file to .env if it is missing.
# Keep these credentials in sync with docker-compose.yml.
DATABASE_URL="postgresql://app_user:test@localhost:5432/flawment?schema=public"

# If 5432 is occupied, change this port AND the port in DATABASE_URL above.
POSTGRES_PORT=5432

# Used only when the super admin is first created. Reruns preserve its password.
SUPER_ADMIN_EMAIL=admin@flawment.local
SUPER_ADMIN_PASSWORD=FlawmentAdmin123!

# Flawiusz agent. Add your OpenRouter API key; see "Set up Flawiusz" in README.md.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_API_KEY=
