generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  TO_DO
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Owner: created the project (a manager); everything, incl. deleting it and naming coordinators.
// Coordinator: runs the work: the project, its stages, every task, adding contributors.
// Contributor: sees the project, adds tasks and works on their own.
enum ProjectRole {
  OWNER
  COORDINATOR
  CONTRIBUTOR
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum AbsenceType {
  VACATION
  SICK_LEAVE
  BUSINESS_TRIP
  OTHER
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  email             String             @unique
  password          String
  first_name        String
  last_name         String
  is_active         Boolean            @default(true)
  role              UserRole           @default(USER)
  photo             Bytes?             @db.ByteA
  photo_updated_at  DateTime?
  // Colleagues see only the day and month.
  birth_date        DateTime?          @db.Date
  // Teams are assigned by a super admin, not chosen by the user.
  team_id           Int?
  team              Team?              @relation(fields: [team_id], references: [id], onDelete: SetNull)
  // Leads see why their team members are away. Cleared when the team changes.
  team_lead         Boolean            @default(false)
  // Picked from the JobTitle list by a super admin.
  job_title_id      Int?
  job_title         JobTitle?          @relation(fields: [job_title_id], references: [id], onDelete: SetNull)
  pronouns          String?
  phone             String?
  location          String?
  working_hours     String?
  skills            String[]           @default([])
  // A short custom status ("🍽️ Lunch"), hidden once status_expires_at passes.
  status_emoji      String?
  status_text       String?
  status_expires_at DateTime?
  // When the account was created: also the start date for work anniversaries.
  created_at        DateTime           @default(now())
  absences          Absence[]
  sessions          Session[]
  templates         DocumentTemplate[]

  title_requests_about   JobTitleRequest[] @relation("TitleRequestPerson")
  title_requests_made    JobTitleRequest[] @relation("TitleRequestRequester")
  title_requests_decided JobTitleRequest[] @relation("TitleRequestDecider")

  owned_projects Project[]           @relation("ProjectOwner")
  memberships    ProjectMembership[]
  assigned_tasks Task[]              @relation("TaskAssignee")
  created_tasks  Task[]              @relation("TaskCreator")

  @@index([team_id])
  @@index([job_title_id])
}

// The job titles a super admin picks from; new ones are added as needed.
// Only people whose title can_lead may be made a team lead.
model JobTitle {
  id         Int      @id @default(autoincrement())
  name       String
  name_key   String   @unique
  can_lead   Boolean  @default(false)
  users      User[]
  created_at DateTime @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// A team lead asks a super admin to change a team member's job title.
// `title` is a name, so a lead may suggest one that is not on the list yet.
model JobTitleRequest {
  id           Int           @id @default(autoincrement())
  user_id      Int
  user         User          @relation("TitleRequestPerson", fields: [user_id], references: [id], onDelete: Cascade)
  requested_by Int
  requester    User          @relation("TitleRequestRequester", fields: [requested_by], references: [id], onDelete: Cascade)
  title        String
  note         String?
  status       RequestStatus @default(PENDING)
  decided_by   Int?
  decider      User?         @relation("TitleRequestDecider", fields: [decided_by], references: [id], onDelete: SetNull)
  decided_at   DateTime?
  created_at   DateTime      @default(now())

  @@index([status])
  @@index([user_id])
  @@index([requested_by, decided_at])
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  name_key   String   @unique
  members    User[]
  created_at DateTime @default(now())
}

// Time off. Other people only learn that someone is away, never the type or note.
model Absence {
  id         Int         @id @default(autoincrement())
  user_id    Int
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       AbsenceType
  start_date DateTime    @db.Date
  end_date   DateTime    @db.Date
  note       String?
  created_at DateTime    @default(now())

  @@index([user_id, end_date])
}

model Session {
  token_hash String   @id
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime

  @@index([user_id])
  @@index([expires_at])
}

model LoginAttempt {
  key        String   @id
  count      Int      @default(1)
  expires_at DateTime
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  start_date  DateTime      @db.Date
  end_date    DateTime?     @db.Date
  status      ProjectStatus @default(TO_DO)

  owner_id Int
  owner    User @relation("ProjectOwner", fields: [owner_id], references: [id])

  memberships        ProjectMembership[]
  tasks              Task[]
  stages             ProjectStage[]
  document_templates DocumentTemplate[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  project_id Int
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  stage_id Int?
  stage    ProjectStage? @relation(fields: [stage_id], references: [id], onDelete: SetNull)

  assigned_to Int?
  assignee    User? @relation("TaskAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  created_by Int
  creator    User @relation("TaskCreator", fields: [created_by], references: [id])

  deadline DateTime?    @db.Date
  status   TaskStatus   @default(TO_DO)
  priority TaskPriority @default(MEDIUM)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([stage_id])
}

model ProjectMembership {
  id Int @id @default(autoincrement())

  project_id Int
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  role      ProjectRole @default(CONTRIBUTOR)
  joined_at DateTime    @default(now())

  @@unique([project_id, user_id])
}

// Custom document templates. `blocks` holds the ordered template layout,
// validated by lib/documents/template-schema.ts before it is saved.
model DocumentTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  blocks      Json
  show_status Boolean  @default(true)
  show_name   Boolean  @default(true)
  owner_id    Int?
  owner       User?    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  // Null for templates the owner can use in all of their projects.
  project_id  Int?
  project     Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_id])
  @@index([project_id])
}

model ProjectStage {
  id          Int       @id @default(autoincrement())
  project_id  Int
  project     Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  deadline    DateTime? @db.Date
  tasks       Task[]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([project_id, name])
  @@index([project_id])
}
